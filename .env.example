# ==============================================================================
# THE GOLDEN VOTE — CONFIGURACIÓN DE ENTORNO EN PRODUCCIÓN
# ==============================================================================

PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. PAYPAL CHECKOUT (API Orders v2)
# Obtén tus credenciales en https://developer.paypal.com/dashboard/applications
# ------------------------------------------------------------------------------
PAYPAL_ENVIRONMENT=sandbox # Cambiar a 'live' cuando pases a producción
PAYPAL_CLIENT_ID=sb
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_aqui
PAYPAL_WEBHOOK_ID=tu_paypal_webhook_id_aqui

# ------------------------------------------------------------------------------
# 2. WOMPI (COLOMBIA - Tarjetas, PSE, Nequi, Bancolombia)
# Obtén tus llaves en https://comercios.wompi.co o https://sandbox.wompi.co
# ------------------------------------------------------------------------------
WOMPI_ENVIRONMENT=sandbox # Cambiar a 'production' cuando actives tu comercio
WOMPI_PUBLIC_KEY=pub_test_placeholder
WOMPI_PRIVATE_KEY=prv_test_placeholder
WOMPI_INTEGRITY_SECRET=test_integrity_secret_aqui
WOMPI_EVENTS_SECRET=test_events_secret_aqui

# Tasa de conversión USD a COP para la pasarela Wompi (1 Punto = 1 USD)
USD_COP_RATE=4200

# ------------------------------------------------------------------------------
# 3. STRIPE (Opcional si usas Stripe además de PayPal y Wompi)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
